#!/bin/sh
set -eu

# Set only by the watch loop from the XFixes watcher; never from the environment.
watched_compositor=

print_default_names() {
	count=${1:-9}
	i=1
	sep=
	while [ "$i" -le "$count" ]; do
		printf '%s%s' "$sep" "$i"
		sep='|'
		i=$((i + 1))
	done
}

clean_line() {
	tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

root_property_value() {
	prop=$1
	# xprop prints most values as "NAME(TYPE) = value", but window lists
	# such as _NET_CLIENT_LIST as "NAME(WINDOW): window id # 0x1, 0x2".
	xprop -root "$prop" 2>/dev/null | sed -n 's/^[^=]*= //p;t;s/^[^:]*):[[:space:]]*//p'
}

compositor_active() {
	# In watch mode the XFixes watcher is authoritative.
	if [ -n "$watched_compositor" ]; then
		printf '%s' "$watched_compositor"
		return
	fi
	if command -v pgrep >/dev/null 2>&1 &&
		pgrep -u "$(id -u)" -x picom >/dev/null 2>&1; then
		printf '1'
	else
		printf '0'
	fi
}

root_status() {
	xprop -root WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^WM_NAME/ {
				status = $2
				gsub(/^"/, "", status)
				gsub(/"$/, "", status)
				print status
				found = 1
				exit
			}
			END {
				if (!found) {
					print ""
				}
			}
		' | clean_line
}

desktop_names() {
	names=$(root_property_value _NET_DESKTOP_NAMES | awk '
		BEGIN { RS = ","; sep = "" }
		{
			gsub(/^[[:space:]]*"/, "")
			gsub(/"[[:space:]]*$/, "")
			if ($0 != "") {
				printf "%s%s", sep, $0
				sep = "|"
			}
		}
	')
	if [ -n "$names" ]; then
		printf '%s' "$names"
	else
		print_default_names "$1"
	fi
}

active_window_id() {
	xdotool getactivewindow 2>/dev/null || {
		root_property_value _NET_ACTIVE_WINDOW |
			sed -n 's/^window id # //p' |
			awk '$1 != "0x0" { print $1; exit }'
	}
}

occupied_workspaces() {
	root_property_value _NET_CLIENT_LIST |
		tr ',' '\n' |
		while IFS= read -r window_id; do
			window_id=$(printf '%s\n' "$window_id" | awk '{ print $NF }')
			case $window_id in
			0x*) ;;
			*) continue ;;
			esac
			xprop -id "$window_id" _NET_WM_DESKTOP 2>/dev/null |
				awk -F'= ' '$2 ~ /^[0-9]+$/ && $2 != 4294967295 { print $2 }'
		done |
		sort -nu |
		paste -sd '|' -
}

fullscreen_monitors() {
	root_property_value _DWM_FULLSCREEN_MONITORS |
		tr ',' '\n' |
		awk '$1 ~ /^[0-9]+$/ { print $1 }' |
		sort -nu |
		paste -sd '|' -
}

running_apps() {
	seen='|'
	root_property_value _NET_CLIENT_LIST |
		tr ',' '\n' |
		while IFS= read -r window_id; do
			window_id=$(printf '%s\n' "$window_id" | awk '{ print $NF }')
			case $window_id in
			0x*) ;;
			*) continue ;;
			esac
			pid=$(xprop -id "$window_id" _NET_WM_PID 2>/dev/null | awk -F'= ' '$2 ~ /^[0-9]+$/ { print $2; exit }')
			if [ -n "$pid" ] && [ "$(ps -o uid= -p "$pid" 2>/dev/null | awk '{ print $1 }')" = 0 ]; then
				continue
			fi
			class=$(window_class "$window_id" || true)
			[ -n "$class" ] || continue
			case $seen in
			*"|$class|"*) continue ;;
			esac
			seen="$seen$class|"
			printf '%s:%s\n' "$window_id" "$class"
		done |
		paste -sd '|' -
}

# Desktops each app has windows on: "class:0,2|class2:1". Sticky windows
# (on every desktop) are left out.
app_desktops() {
	root_property_value _NET_CLIENT_LIST |
		tr ',' '\n' |
		while IFS= read -r window_id; do
			window_id=$(printf '%s\n' "$window_id" | awk '{ print $NF }')
			case $window_id in
			0x*) ;;
			*) continue ;;
			esac
			class=$(window_class "$window_id" || true)
			[ -n "$class" ] || continue
			desktop=$(xprop -id "$window_id" _NET_WM_DESKTOP 2>/dev/null |
				awk -F'= ' '$2 ~ /^[0-9]+$/ && $2 != 4294967295 { print $2 }')
			[ -n "$desktop" ] || continue
			printf '%s\t%s\n' "$class" "$desktop"
		done |
		sort -u |
		awk -F'\t' '
			!($1 in list) { order[n++] = $1 }
			{ list[$1] = ($1 in list) ? list[$1] "," $2 : $2 }
			END { for (i = 0; i < n; i++) printf "%s%s:%s", (i ? "|" : ""), order[i], list[order[i]] }
		'
}

window_title() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" _NET_WM_NAME WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^_NET_WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				print title
				found = 1
				exit
			}
			/^WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				fallback = title
			}
			END {
				if (!found && fallback != "") {
					print fallback
				}
			}
		' | clean_line
}

window_class() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" WM_CLASS 2>/dev/null |
		awk -F'= ' '/^WM_CLASS/ { gsub(/"/, "", $2); split($2, classes, /, /); print tolower(classes[2]); exit }'
}

show_state() {
	current=$(root_property_value _NET_CURRENT_DESKTOP | awk '{ print $1; exit }')
	count=$(root_property_value _NET_NUMBER_OF_DESKTOPS | awk '{ print $1; exit }')
	current=${current:-0}
	count=${count:-9}
	names=$(desktop_names "$count")
	window_id=$(active_window_id)
	title=$(window_title "$window_id" || true)
	title=${title:-Desktop}
	class=$(window_class "$window_id" || true)
	class=${class:-application-x-executable}
	status=$(root_status)
	occupied=$(occupied_workspaces)
	fullscreen_monitors=$(fullscreen_monitors)
	apps=$(running_apps)
	app_desktops=$(app_desktops)
	monitor_desktops=$(
		root_property_value _DWM_MONITOR_DESKTOPS |
			tr -d '[:space:]'
	)
	monitor_desktops=${monitor_desktops:-$current}
	focused_monitor=$(root_property_value _DWM_SELECTED_MONITOR | awk '{ print $1; exit }')

	printf 'current=%s\n' "$current"
	printf 'monitor_desktops=%s\n' "$monitor_desktops"
	printf 'focused_monitor=%s\n' "$focused_monitor"
	printf 'count=%s\n' "$count"
	printf 'names=%s\n' "$names"
	printf 'occupied=%s\n' "$occupied"
	printf 'fullscreen_monitors=%s\n' "$fullscreen_monitors"
	printf 'apps=%s\n' "$apps"
	printf 'app_desktops=%s\n' "$app_desktops"
	printf 'active_window=%s\n' "$window_id"
	printf 'title=%s\n' "$title"
	printf 'class=%s\n' "$class"
	printf 'status=%s\n' "$status"
	printf 'compositor=%s\n' "$(compositor_active)"
}

spy_root_events() {
	if xprop -root _DWM_MONITOR_DESKTOPS >/dev/null 2>&1; then
		xprop -root -spy \
			DWM_TAG_UPDATE \
			_DWM_MONITOR_DESKTOPS \
			_DWM_SELECTED_MONITOR \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			WM_NAME 2>/dev/null
	else
		xprop -root -spy \
			DWM_TAG_UPDATE \
			_NET_CURRENT_DESKTOP \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			WM_NAME 2>/dev/null
	fi
}

# Picom often starts after the shell, and starting or stopping it changes no
# root property. dwm-settings-picom owner-watch streams the compositor
# selection owner from XFixes events and prints compositor=0|1 on each change.
picom_helper() {
	helper=${0%/*}/dwm-settings-picom
	[ -x "$helper" ] || helper=$(command -v dwm-settings-picom 2>/dev/null) || return 1
	printf '%s' "$helper"
}

watch_state() {
	show_state
	printf '\n'

	{
		compositor_watcher=
		if helper=$(picom_helper); then
			# Started as a plain background command so $! is the watcher itself.
			# It also exits on its own when this script ends ($$ is the top
			# level even inside the pipeline subshell). Errors go to stderr.
			"$helper" owner-watch --parent "$$" &
			compositor_watcher=$!
		fi
		spy_root_events || :
		# Without the root spy there is no state stream; end the watcher so
		# the reader sees EOF and the command exits.
		if [ -n "$compositor_watcher" ]; then
			kill "$compositor_watcher" 2>/dev/null || :
		fi
	} |
		while IFS= read -r event; do
			case $event in
			compositor=[01]) watched_compositor=${event#compositor=} ;;
			esac
			show_state
			printf '\n'
		done
}

switch_workspace() {
	target=${1:-}
	case $target in
	'' | *[!0-9]*)
		printf 'usage: %s switch <zero-based-workspace>\n' "$0" >&2
		return 2
		;;
	esac
	command -v wmctrl >/dev/null 2>&1 || {
		printf 'wmctrl is required for workspace switching\n' >&2
		return 127
	}
	wmctrl -s "$target"
}

focus_window() {
	target=${1:-}
	case $target in
	0x[0-9a-fA-F]* | [0-9]*) ;;
	*)
		printf 'usage: %s focus <window-id>\n' "$0" >&2
		return 2
		;;
	esac
	wmctrl -ia "$target"
}

# Close an app: send WM_DELETE_WINDOW to every client window that shares the
# target window's WM_CLASS class, the same request dwm sends when a window is
# closed from the keyboard, so the app can still confirm unsaved work.
close_app() {
	target=${1:-}
	case $target in
	0x[0-9a-fA-F]* | [0-9]*) ;;
	*)
		printf 'usage: %s close <window-id>\n' "$0" >&2
		return 2
		;;
	esac
	command -v python3 >/dev/null 2>&1 || {
		printf 'python3 is required to close windows\n' >&2
		return 127
	}
	python3 - "$target" <<'PY'
import ctypes
import ctypes.util
import sys

x11 = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11") or "libX11.so.6")
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XGetWindowProperty.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long, ctypes.c_long,
    ctypes.c_int, ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_void_p)]
x11.XSendEvent.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_long, ctypes.c_void_p]
x11.XFree.argtypes = [ctypes.c_void_p]
x11.XFlush.argtypes = [ctypes.c_void_p]
x11.XCloseDisplay.argtypes = [ctypes.c_void_p]


class ClientMessage(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("window", ctypes.c_ulong),
                ("message_type", ctypes.c_ulong), ("format", ctypes.c_int),
                ("data", ctypes.c_long * 5)]


class Event(ctypes.Union):
    _fields_ = [("xclient", ClientMessage), ("pad", ctypes.c_long * 24)]


dpy = x11.XOpenDisplay(None)
if not dpy:
    sys.exit("cannot open the X display")


def prop(win, name, kind):
    actual, fmt = ctypes.c_ulong(), ctypes.c_int()
    count, after, data = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
    if x11.XGetWindowProperty(dpy, win, x11.XInternAtom(dpy, name, 0), 0, 4096, 0, kind,
                              ctypes.byref(actual), ctypes.byref(fmt), ctypes.byref(count),
                              ctypes.byref(after), ctypes.byref(data)) != 0 or not data.value:
        return None, 0
    return data, count.value


def wm_class(win):
    data, count = prop(win, b"WM_CLASS", 31)  # XA_STRING
    if data is None:
        return ""
    raw = ctypes.string_at(data, count)
    x11.XFree(data)
    parts = raw.split(b"\0")
    return (parts[1] if len(parts) > 1 else parts[0]).decode("utf-8", "replace")


target = int(sys.argv[1], 0)
cls = wm_class(target)
root = x11.XDefaultRootWindow(dpy)
data, count = prop(root, b"_NET_CLIENT_LIST", 33)  # XA_WINDOW
windows = list(ctypes.cast(data, ctypes.POINTER(ctypes.c_ulong))[:count]) if data else []
if data:
    x11.XFree(data)
victims = [w for w in windows if w == target or (cls and wm_class(w) == cls)] or [target]
protocols = x11.XInternAtom(dpy, b"WM_PROTOCOLS", 0)
delete = x11.XInternAtom(dpy, b"WM_DELETE_WINDOW", 0)
for win in victims:
    event = Event()
    event.xclient.type = 33  # ClientMessage
    event.xclient.window = win
    event.xclient.message_type = protocols
    event.xclient.format = 32
    event.xclient.data[0] = delete
    event.xclient.data[1] = 0  # CurrentTime
    x11.XSendEvent(dpy, win, 0, 0, ctypes.byref(event))
x11.XFlush(dpy)
x11.XCloseDisplay(dpy)
PY
}

case ${1:-state} in
state)
	show_state
	;;
watch)
	watch_state
	;;
switch)
	switch_workspace "${2:-}"
	;;
focus)
	focus_window "${2:-}"
	;;
close)
	close_app "${2:-}"
	;;
*)
	printf 'usage: %s [state|watch|switch <zero-based-workspace>|focus <window-id>|close <window-id>]\n' "$0" >&2
	exit 2
	;;
esac
